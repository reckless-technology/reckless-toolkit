# The toolkit's source documentation: Doxygen 1.14 on every directory of shipping code and the suites' shared
# support (not the test cases), with README.md as the main page and docs/namespaces.dox documenting every namespace
# once, into build/doxygen/html/. Every warning - an undocumented class, function, member, parameter or return value -
# goes to build/doxygen/warnings.log, which must be empty: build.yml's doxygen job fails on any.
#
#   doxygen Doxyfile                                  # from the toolkit's root
#   RECKLESS_VERSION=<commit> doxygen Doxyfile        # a version under the title
#
# Only the settings that differ from Doxygen's defaults are written here; `doxygen -x Doxyfile` lists them.

PROJECT_NAME           = "Reckless Technology toolkit"
PROJECT_NUMBER         = $(RECKLESS_VERSION)
PROJECT_BRIEF          = "What the company's products share: files, drawing, views, windows, audio devices, network"
PROJECT_LOGO           = assets/logos/RecklessAppIcon64.png
OUTPUT_DIRECTORY       = build/doxygen
STRIP_FROM_PATH        = .
FULL_PATH_NAMES        = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO
MARKDOWN_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
DISTRIBUTE_GROUP_DOC   = YES
TAB_SIZE               = 4
EXTENSION_MAPPING      = mm=C++
NUM_PROC_THREADS       = 1

# Everything documented where it is declared, private members and a .cpp's anonymous namespaces among it.
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_PRIV_VIRTUAL   = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
INTERNAL_DOCS          = YES
CASE_SENSE_NAMES       = YES
SHOW_INCLUDE_FILES     = YES
SORT_MEMBER_DOCS       = NO
SHOW_USED_FILES        = YES

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = build/doxygen/warnings.log

INPUT                  = README.md \
                         docs/namespaces.dox \
                         app \
                         audio \
                         core \
                         gfx \
                         licence \
                         look \
                         net \
                         panel \
                         skia \
                         update \
                         view \
                         window \
                         tests
FILE_PATTERNS          = *.h \
                         *.cpp \
                         *.mm
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */test_*.cpp \
                         */test_*.mm \
                         */assets/*
USE_MDFILE_AS_MAINPAGE = README.md
FILTER_PATTERNS        = "*README.md=python3 tools/doxygen_readme_filter.py"
IMAGE_PATH             = assets/logos

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = core \
                         gfx \
                         look \
                         view \
                         panel \
                         window \
                         audio \
                         net \
                         licence \
                         update \
                         app \
                         tests
PREDEFINED             = __cplusplus=202002L \
                         __linux__ \
                         DOXYGEN

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO
VERBATIM_HEADERS       = YES
ALPHABETICAL_INDEX     = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = AUTO_LIGHT
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
GENERATE_LATEX         = NO

# Graphviz's dot draws the class hierarchies and the directory graph; the rest would be noise at this size.
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
DIRECTORY_GRAPH        = YES
DOT_GRAPH_MAX_NODES    = 80
